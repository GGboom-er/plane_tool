//-----------------------------------------------------------------------------------------------
/*  
  author: Joe Harkins    			 				www.creaturetd.com
  name: animToBlend
  date: 07/20/05

  description:
  converts animation into blendShapes
  for every frame a new shape will be duplicated
  it will automatically group the new shapes and name them accordingly
  the result can then be used to create a blendshape with inbetweens
  
  arguements: 
  string $obj = the name of the object you wish to run animToBlend on
  string $char = a character prefix for naming purposes
  string $name = what you want the resulting name to be
  
  example:
  animToBlend ("hires_geo_character","cat","browsUpLf");
  
*/
//-----------------------------------------------------------------------------------------------
// kevin update 
global proc animToBlend (string $obj, string $char, string $name) {

	float $start  = `playbackOptions -q -min`;
	float $end  = `playbackOptions -q -max`;
	float $frame = `currentTime -q`;
	float $step = 1;
	string $dupe[];
	string $parent = `createNode transform -name  ($char + "_" + $name + "_blend")`;	

	progressWindow -t "animToBlend" -progress $start -status ("animToBlend on frame: "+$frame) -min $start -max $end -isInterruptable true;
	
	
	for($i=$start;$i<=$end;$i+=$step)	
	for($frame=$start;$frame<=$end;$frame+=$step)
		{
		currentTime $frame;  
		if($frame == $end) $dupe = `duplicate -name ($char  + "_" + $name) $obj`; 
		else $dupe = `duplicate -name ($char + "_" + $name + "_" + $frame) $obj`; 
		parent $dupe[0] $parent;
		if(`progressWindow -q -isCancelled`) { progressWindow -endProgress; undoInfo -state on;return;}
		progressWindow -e -progress $frame -status ("running animToBlend on frame: "+$frame);
		}
	progressWindow -endProgress; 
	print ("successfully created " + $name + " blendShape targets for " + $char + "\n");
	currentTime $start;  
	}

//-----------------------------------------------------------------------------------------------
/*  
  author: Joe Harkins    			 				www.creaturetd.com
  name: exportBlends
  date: 07/20/05

  description:
  exports each selected object into a user specified directory as an individual .ma file
  calls the exportCallback which launches the dir browser.  Select the directory you want
  the objects to be exported to.
  
  The name of the file will be the name of the object in Maya.
  
  ! WARNING ! it WILL automatically save over scene files with the same name!
  
  arguements: 
  none
  
  example:
  select objects to export
  type exportBlends in the command line and return
  select the directory to export to
  
*/
//-----------------------------------------------------------------------------------------------

global proc exportBlends (){
	fileBrowserDialog -mode 4 -fc "exportCallback" -an "Pick Your Blend Shape Directory";
	return;
	}

global proc exportCallback(string $path, string $mode){
	print ("this is the dir path: " + $path + "\n");
	string $objs[] = `ls -sl`;
	for ($obj in $objs){
		select $obj;
		file -es -type "mayaAscii" ($path + "/" + $obj);
		delete $obj;
		print "successfully exported objects! \n";
		}
	}

//-----------------------------------------------------------------------------------------------
/*  
  author: Joe Harkins    			 				www.creaturetd.com
  name: importBlends
  date: 07/20/05

  description:
  imports each file from a directory and adds it as a blendShape with inbetweens onto the selected mesh
  The name of the blendShape will be the name of the node in the imported scene file
  for best results use in conjunction with exportBlends
  
  arguements: 
  none
  
  example:
  select object to import blendshapes onto
  type importBlends in the command line and return
  select the directory to import from
  
*/
//-----------------------------------------------------------------------------------------------

global proc importBlends (){
	fileBrowserDialog -mode 4 -fc "importCallback" -an "Pick Your Blend Shape Directory";
	return;
	}
	
global proc importCallback(string $path, string $mode){
	string $bases[] = `ls -sl`;
	float $size = `size $bases`;
	string $base = $bases[0];
	select -ado;
	string $before[] = `ls -sl`;
	print ("this is the dir path: " + $path+ "\n");
	string $folder[] = `getFileList -folder ($path+ "/")`;
	string $file;
	for ($file in $folder){
		file -import ($path + "/" + $file);
		select -ado;
		string $during[] = `ls -sl`;
		string $after[] = stringArrayRemove($before, $during);
		string $newTarget[] = `listRelatives -c $after[0]`;
		int $lst = size($newTarget) -1;
	
	//kevin
		string $bsName=($after[0] + "Shape");
		if (`objExists $bsName`){
				delete $bsName;
		}
	//kevin
	
		select $newTarget;
		select -add $base;
		blendShape -ib -foc -name ($after[0] + "Shape");
		delete $after[0];
		
	if($size > 1){		
			string $control = $bases[1];
			addAttr -ln $newTarget[$lst] -keyable true -min 0 -max 10 -dv 0 $control;
			string $sr = `createNode setRange -n ($newTarget[$lst] + "_sr")`;
			connectAttr ($control + "." + $newTarget[$lst]) ($sr + ".valueX");
			setAttr ($sr + ".oldMinX") 0;
			setAttr ($sr + ".oldMaxX") 10;
			setAttr ($sr + ".minX") 0;
			setAttr ($sr + ".maxX") 1;
			connectAttr ($sr + ".outValueX") ($after[0] + "Shape." + $newTarget[$lst]);
			print (" imported blendShape " + $after[0] + " onto "  + $base + "\n");
			}
	}
	select $base;
}


//-----------------------------------------------------------------------------------------------
/*  
  author: Joe Harkins    			 				www.creaturetd.com
  name: skinClusterToCluster
  date: 07/20/05

  description:
  turns a skinCluster into cluster or soft mod deformers
  
  User inputs a skinCluster node on the mesh to convert from skinCluster to Clusters
  First, the procedure iterates through each influence in the skinCluster and selects all the point
  in the mesh that it has an influence over.  From the selected points, the proc makes a cluster or
  soft mod and sets the weighted node to be the joint/influence from the skinCluster node.
  
  The resut is a cluster or soft mod per influence with the exact same membership and weighting.
  
  arguements: 
  string $skinCluster = the name of a skinCluster in the scene
  string $base = a mesh to copy the clusters onto
  string $type = choice between "cluster" and "soft"
  
  example:
  In a new scene create a sphere and a few joints, then smooth bind the sphere to the joints.
  Run the procedure to turn the skinCluster in individual cluster or soft mod deformers.
  
  skinClusterToCluster skinCluster1 baseGeo cluster;
  
*/
//-----------------------------------------------------------------------------------------------

global proc skinClusterToCluster (string $skinCluster, string $base, string $type){
	string $infs[] = `skinCluster -q -inf $skinCluster`;

	progressWindow -t "skinClusterToCluster" -progress 0 -status ("skinClusterToCluster for: "+$skinCluster) -min 0 -max `size $infs` -isInterruptable true;

	for ($i in $infs){

		if(`progressWindow -q -isCancelled`) { progressWindow -endProgress; undoInfo -state on;return;}
		progressWindow -e -step 1 -status ("running skinClusterToCluster on : "+$i);
		//kevin
		group -em -n ($i + "_control"); xform -os -piv 0 0 0;
		group -n ($i + "_control_zero") ($i + "_control");
		delete `pointConstraint -w 1 -o 0 0 0 $i ($i + "_control_zero")`;
		select -cl;
		//kevin
		selectInfluencedPoints $i;
		
		string $points[] = `ls -sl -fl`;
		string $tokens[];
		string $newPoint;
		select -cl;
		
		for ($p = 0; $p < size($points); $p++){
				$numTokens = tokenize($points[$p], ".", $tokens);
				string $actualVert = $tokens[1];
				$newPoint = ($base + "." + $actualVert);
				select -add $newPoint;
				}
		string $clusters[];	
		string $newPoints[] = `ls -sl  -fl`;
		
		if ($type == "cluster"){
				$clusters = `cluster -n ($i + "_cluster") $newPoints`;
				string $cShape[] = `listConnections -s 1 ($clusters[0]+".clusterXforms")`;
				
				cluster -e -wn ($i + "_control") ($i + "_control") -bs 1 $cShape[0];
				delete ($i + "_clusterHandle");
				setAttr ($i + "_clusterHandleShape.visibility") 0;
					
				for ($p = 0; $p < size($points); $p++){
					$infValue = `skinPercent -t $i -q -v $skinCluster $points[$p]`;
					if ($infValue > 0.0) percent -v $infValue  ($i + "_cluster") $newPoints[$p];
					}
				}
		select $base;
		select -add ($i + "_control");
		hyperRealMeshParent;
		delete ($i + "_control_zero");
	}
	//delete $skinCluster;
	hide $infs;
	
	string $secCtrls[] = `ls "*_control"`;
	controlCircleCreator $secCtrls 1 0 0 .25;

	progressWindow -endProgress;
}

//-----------------------------------------------------------------------------------------------
/*  
  author: Joe Harkins    			 				www.creaturetd.com
  name: selectInfluencedPoints
  date: 07/20/05

  description:
  selects all of the points associated with an influence that has been weighted > 0.
  
  arguements: 
  string $infName = the name of an influence object from a skinCluster in the scene
  
  example:
  
  selectInfluencedPoints joint1;
  
*/
//-----------------------------------------------------------------------------------------------

global proc selectInfluencedPoints(string $infName){
	string $results[] = `listConnections -type skinCluster $infName`;
	string $skinCluster = $results[0];
	string $skinClusterSet[] = `listConnections -type objectSet $skinCluster`;
	string $components[] = `sets -q $skinClusterSet[0]`;
	$components = `filterExpand -sm 36 -sm 28 -sm 31 -sm 46 $components`;
	global string $gMainProgressBar;
	progressBar -edit
 		-beginProgress
 		-isInterruptable true 
 		-status "selecting points..." 
 		-maxValue `size $components`
 		$gMainProgressBar;

	string $affectedPoints[];
	for ($c in $components){
		$infValue = `skinPercent -t $infName -q -v $skinCluster $c`;
		if ($infValue > 0.0) $affectedPoints[`size $affectedPoints`] = $c;
		if(`progressBar -query -isCancelled $gMainProgressBar`) break;
		progressBar -edit -step 1 $gMainProgressBar;
		}
	
	progressBar -edit -endProgress $gMainProgressBar;
	select -r $affectedPoints;
}

