}
*/
//puts selected objects in reference mode
//
global proc makeReference(string $sel[]){
	
string $obj;

	for($obj in $sel){
		setAttr ($obj + ".overrideEnabled") 1;
		setAttr ($obj + ".overrideDisplayType") 2;
		}
}

//-----------------------------------------------------------------------------------------------
/*  
  author: Joe Harkins    			 				www.creaturetd.com
  name: polyAvgVtx
  date: 07/20/05

  description:
  creates a polyAverageVertex node for selected points
  
  What is a polyAverageVertex node?
  
  A smoothing node that smoothes the object without introducing additional vertices (as opposed to smooth).
  At each step, vertices are moved towards the average of its immediate neighbours.

  the inputs for the polyAverageVertex node are:
  alpha(a) = a ratio of alpha and beta defines how the smoothing will work on the components, default is .5
  beta(b) = a ratio of alpha and beta defines how the smoothing will work on the components, default is .7
  iterations(i) = the number of iterations the smoothing ratio should be applied to the components
  
  To setup automatic averaging, this script allows you to select the components to be averaged, a node that
  will control smoothing, and finally the channels on that node that will directly control the smoothing.
  
  max iterations is clamped to the number you specify, 10 - 15 is a good range.
  
  from the channel box you can highlight the attributes that will control smoothing
  These attributes are then averaged and input to the iterations attribute of the polyAverageVertex node.
  An "on" multiplier controls the amount of smoothing, default is 1
  
  smoothness * on = iterations
  
  arguements: 
  string $components[] = list of selected vertices
  string $name = name of resulting polyAverageVertex node
  float $max = the max clamp for iterations

  
  example:
  select some vertices on a polygonal mesh
  shift select an object that has attributes you want to control smoothing
  from the channel box, highlight the attributes that will control smoothing
  run this from the command line:
  polyAvgVtx `ls -sl` test_pav 15;
  
*/
//-----------------------------------------------------------------------------------------------

global proc polyAvgVtx (string $components[], string $name, float $max){
	
	int $lst = size($components) -1;
	string $parent = $components[$lst];
	select -d $parent;
	$components = `ls -sl`;

	string $paVtx[] = `polyAverageVertex $components`;
	string $pav = ($name + "_pav");
	rename $paVtx[0] $pav;
	addAttr -ln alphaIn -sn ar -dv .5 -k 1 $pav;
	addAttr -ln betaIn -sn br -dv .7 -k 1 $pav;
	addAttr -ln "on" -dv 1 -k 1 -at "float" -min 0 -max 5 $pav;
	addAttr -ln "smoothness" -dv 0 -k 1 -at "float" -min 0 -max $max $pav;
	connectAttr -f ($pav+".ar") ($pav+".a");
	connectAttr -f ($pav+".br") ($pav+".b");
	
	string $mult = `createNode multDoubleLinear -n ($name + "_pavMult")`;
	connectAttr ($pav + ".on") ($mult + ".i1");
	connectAttr ($pav + ".smoothness") ($mult + ".i2");
	connectAttr ($mult + ".o") ($pav + ".i");
	
	string $pma = `createNode plusMinusAverage -name ($name + "_pav_pma")`;
	string $attrs[] = `channelBox -q -sma mainChannelBox`;

	for ($i = 0; $i < size($attrs); $i++){
			string $abs = `createNode condition -n ($name + "_" + $attrs[$i] + "_abs")`;
			string $multabs = `createNode multDoubleLinear -n ($name + "_" + $attrs[$i] + "_multabs")`;
			connectAttr ($parent + "." + $attrs[$i]) ($abs + ".ft");
			setAttr ($abs + ".st") 0;
			setAttr ($abs + ".operation") 3;
			setAttr ($abs + ".ctr") 1;
			setAttr ($abs + ".cfr") -1;
			connectAttr ($abs + ".ocr") ($multabs + ".i1");
			connectAttr ($parent + "." + $attrs[$i]) ($multabs + ".i2");
			connectAttr -f ($multabs + ".o") ($pma + ".i1[" + $i + "]");
			}
			
	setAttr ($pma + ".operation") 3;
	string $clamp = `createNode clamp -name ($name + "_clmp")`;
	setAttr ($clamp + ".mnr") 0;
	setAttr ($clamp + ".mxr") $max;
	connectAttr ($pma + ".output1D") ($clamp + ".ipr");
	connectAttr ($clamp + ".opr") ($pav + ".smoothness");
}
	
//-----------------------------------------------------------------------------------------------
/*  
  author: Joe Harkins    			 				www.creaturetd.com
  name: stretchy_ik
  date: 07/20/05

  description
  creates stretchy IK setup on selected joints
  
  arguements: 
  string $char = character name
  string $controller = name of control that stretchy attr should be added to
  string $crv = name of IK curve
  string $chain[] = all the joints in the spline IK chain
  
  example:
  select a chain of joints with a spline IK handle
  shift select all the joints in the chain
  run this from the command line:
  stretchy_ik char_name first_joint_in_chain ik_curve `ls -sl`;
  
*/
//-----------------------------------------------------------------------------------------------

global proc stretchy_ik (string $char, string $controller, string $crv, string $chain[]){
	
    addAttr -k on -at double -min 0 -max 1 -dv 0 -ln stretching $controller;
    string $rev = `createNode reverse -n ($char + "_reverse")`;
    connectAttr ($controller + ".stretching") ($rev + ".inputX");
    string $info = `createNode curveInfo -name ($char + "crv_info")`;
    connectAttr -f ($crv + ".worldSpace[0]") ($info + ".inputCurve");
    float  $len = `getAttr ($info + ".arcLength")`;

    string $div = `createNode multiplyDivide -n ($char + "_divide")`;
    setAttr ($div + ".operation") 2;
    connectAttr ($info + ".arcLength") ($div + ".input1X");
    setAttr ($div + ".input2X") $len;
    setAttr ($div + ".input1Y") 1;
    setAttr ($div + ".input2Y") 1;    

    string $bta = `createNode blendTwoAttr -n ($char + "_bta")`;
    connectAttr ($rev + ".outputX") ($bta + ".attributesBlender");
    connectAttr ($div + ".outputX") ($bta + ".input[0]");
    connectAttr ($div + ".outputY") ($bta + ".input[1]");    
    
		for ($c = 0; $c < size($chain); $c++){
	      {
   			addAttr -k on -at double -dv 1 -ln ($chain[$c] + "Squash") $controller;
   			connectAttr  ($controller + "." + $chain[$c] + "Squash") ($chain[$c] + ".scaleZ");
	      float $tx = `getAttr ($chain[$c] + ".scaleX")`;
	      string $mlt = `createNode multiplyDivide -n ($chain[$c] + "_mult")`;    
	      setAttr ($mlt + ".input1X") $tx;
	      connectAttr ($bta + ".output") ($mlt + ".input2X");
	      connectAttr ($mlt + ".outputX") ($chain[$c] + ".scaleX");
	      }
		}
}
//-----------------------------------------------------------------------------------------------
/*  
  author: Joe Harkins    			 				www.creaturetd.com
  name: volumeWire
  date: 07/20/05

  description
  creates stretchy wire deformer setup
  
  arguements: 
  string $base = base geometry
  string $crv = name of curve (must be 4 cv's)
  string $name = name the resulting deformer
  
  example:
 	create a nurbs curve to act as a wire base
  run this from the command line:
  volumeWire base crv ik_curve name;
  
*/
//-----------------------------------------------------------------------------------------------

global proc volumeWire (string $base, string $crv, string $name){

		wire -dds 0 50 -w $crv -name ($name + "_wire") $base;
		
		select ($crv + ".cv[*]");
		string $cvs[] = `ls -sl -fl`;
		for ($c in $cvs){
			float $xfs[] = `xform -q -ws -t $c`;
			select -cl;
			string $joint = `joint -position $xfs[0] $xfs[1] $xfs[2] -name ($name + "_j")`;
			string $clusters[] = `cluster -n ($name + "_cluster") $c`;
			string $cShape[] = `listConnections -s 1 ($clusters[0]+".clusterXforms")`;
			cluster -e -wn $joint $joint -bs 1 $cShape[0];
			select ($name + "_cluster*Handle");
			string $guesscs[] = `ls -sl`;
			for ($g in $guesscs){
					delete;
					setAttr ($g + "Shape.visibility") 0;
					}
			select $joint;
			controlCircleCreator `ls -sl` 0 1 0 3;
			}
		}
		
//-----------------------------------------------------------------------------------------------
